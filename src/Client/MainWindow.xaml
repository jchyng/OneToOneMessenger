<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="OneToOneMessenger_Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:local="using:OneToOneMessenger_Client"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="OneToOne 메신저"
    mc:Ignorable="d">
    <!-- <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop> -->

    <Grid>
        <Grid.Resources>
            <MenuFlyout x:Key="TrayMenu">
                <MenuFlyoutItem Text="열기" Click="TrayOpen_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="종료" Click="TrayExit_Click" />
            </MenuFlyout>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="OneToOne" Subtitle="Messenger">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE8BD;" FontFamily="Segoe Fluent Icons" Foreground="#3D7EFF" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="OneToOneMessenger"
                        ContextFlyout="{StaticResource TrayMenu}"
                        MenuActivation="LeftOrRightClick"
                        DoubleClickCommand="{x:Bind ShowFromTrayCommand}">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="1" Foreground="White" Background="#3D7EFF" />
            </tb:TaskbarIcon.IconSource>
        </tb:TaskbarIcon>
    </Grid>
</Window>
