<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OneToOneMessenger_Client.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:converters="using:OneToOneMessenger_Client.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True">

    <Page.Resources>
        <converters:ChatMessageAlignmentConverter x:Key="ChatMessageAlignmentConverter" />
        <converters:ChatMessageBrushConverter x:Key="ChatMessageBrushConverter" />
        <converters:KoreanTimeConverter x:Key="KoreanTimeConverter" />
        <converters:ReadStateConverter x:Key="ReadStateConverter" />
        <converters:FilePreviewUriConverter x:Key="FilePreviewUriConverter" />
        <converters:ImageCategoryVisibilityConverter x:Key="ImageCategoryVisibilityConverter" />
        <converters:FileCategoryVisibilityConverter x:Key="FileCategoryVisibilityConverter" />
        <converters:TextVisibilityConverter x:Key="TextVisibilityConverter" />
    </Page.Resources>
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchKeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Background="#F7F8FA" Padding="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="White" CornerRadius="12"
              AllowDrop="True" DragOver="ChatArea_DragOver" Drop="ChatArea_Drop">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <Grid Padding="20,12" BorderBrush="#E6EAF0" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="PresenceDot" Text="●" FontSize="12" Foreground="#8A94A6" VerticalAlignment="Center" />
                        <TextBlock Text="짱구" FontSize="18" FontWeight="SemiBold" Foreground="#171C26" />
                    </StackPanel>
                    <TextBlock x:Name="PresenceText" Text="연결 중…" FontSize="12" Foreground="#8A94A6" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Content="검색" Click="SearchButton_Click" />
                    <Button Content="설정" Click="SettingsButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <ListView x:Name="MessagesList" Padding="20" SelectionMode="None"
                          Background="Transparent" BorderThickness="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2" VerticalAlignment="Top"
                                    HorizontalAlignment="{Binding Sender, Converter={StaticResource ChatMessageAlignmentConverter}}">
                            <TextBlock Text="{Binding Sender}" FontSize="11" Foreground="#8A94A6" />
                            <Border Background="{Binding Sender, Converter={StaticResource ChatMessageBrushConverter}}"
                                    CornerRadius="14" Padding="14,10" MaxWidth="520"
                                    VerticalAlignment="Top">
                                <StackPanel Spacing="6" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Body}"
                                               Visibility="{Binding Body, Converter={StaticResource TextVisibilityConverter}}"
                                               TextWrapping="Wrap" FontSize="14" Foreground="#24303F" />
                                    <Grid Visibility="{Binding File.Category, Converter={StaticResource ImageCategoryVisibilityConverter}}">
                                        <Image Source="{Binding File.Id, Converter={StaticResource FilePreviewUriConverter}}"
                                               MaxWidth="360" MaxHeight="220" Stretch="Uniform"
                                               ImageFailed="PreviewImage_Failed"
                                               Tapped="PreviewImage_Tapped" Tag="{Binding File.Id}" />
                                        <TextBlock Text="이미지 미리보기를 불러오지 못했습니다."
                                                   Visibility="Collapsed"
                                                   FontSize="12" Foreground="#738098"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnSpacing="8"
                                          Visibility="{Binding File.Category, Converter={StaticResource FileCategoryVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding File.OriginalName}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="다운로드" Tag="{Binding File}"
                                                Click="DownloadFile_Click" />
                                        <Button Grid.Column="2" Content="다른 이름 저장" Tag="{Binding File}"
                                                Click="SaveAsFile_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                <TextBlock Text="{Binding SentAt, Converter={StaticResource KoreanTimeConverter}}"
                                           FontSize="10" Foreground="#98A1B2" />
                                <TextBlock Text="{Binding IsRead, Converter={StaticResource ReadStateConverter}}"
                                           FontSize="10" Foreground="#3D7EFF" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
                </ListView>
                <Border x:Name="SearchOverlay" Background="White" BorderBrush="#DDE3EC"
                        BorderThickness="1" CornerRadius="10" Padding="12"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20"
                        Width="420" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MessageSearchInput" PlaceholderText="대화 내용 검색…"
                                     KeyDown="MessageSearchInput_KeyDown" />
                            <Button Grid.Column="1" Content="닫기" Margin="8,0,0,0"
                                    Click="CloseSearchButton_Click" />
                        </Grid>
                        <TextBlock x:Name="SearchStatusText" FontSize="11" Foreground="#8A94A6" />
                        <ListView x:Name="SearchResultsList" MaxHeight="320"
                                  IsItemClickEnabled="True" ItemClick="SearchResultsList_ItemClick"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Padding="4">
                                        <TextBlock Text="{Binding Msg.Sender}" FontSize="11"
                                                   Foreground="#8A94A6" />
                                        <TextBlock Text="{Binding HighlightedPreview}" TextWrapping="Wrap"
                                                   FontSize="13" />
                                        <TextBlock Text="{Binding Msg.SentAt, Converter={StaticResource KoreanTimeConverter}}"
                                                   FontSize="10" Foreground="#98A1B2" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Padding="12" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <Button Content="＋" Click="ChooseFile_Click" />
                <TextBox x:Name="MessageInput" Grid.Column="1" PlaceholderText="메시지를 입력하세요…" KeyDown="MessageInput_KeyDown" />
                <Button Grid.Column="2" Content="➤" Click="SendButton_Click" />
                <ProgressBar x:Name="UploadProgress" Grid.Column="1" Grid.ColumnSpan="2" Height="3" VerticalAlignment="Bottom" Visibility="Collapsed" />
                <Button x:Name="RetryButton" Grid.Column="0" Content="재시도" Visibility="Collapsed" Click="RetryButton_Click" />
            </Grid>
            <Border x:Name="ConnectionBanner" Grid.Row="0" Background="#FFF4D6"
                    Padding="12,6" VerticalAlignment="Bottom" Visibility="Collapsed">
                <TextBlock x:Name="ConnectionBannerText" Text="연결 끊김 — 재연결 중…"
                           FontSize="12" Foreground="#8A5A00" />
            </Border>
        </Grid>

        <Grid Grid.Column="1" Margin="12,0,0,0" Background="White" CornerRadius="12" Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="보관함" FontSize="18" FontWeight="SemiBold" Foreground="#171C26" />
            <TextBox x:Name="VaultSearchInput" Grid.Row="1" Margin="0,16,0,12" PlaceholderText="파일명 검색…" KeyDown="VaultSearchInput_KeyDown" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                <Button Content="전체" Tag="" Click="VaultCategory_Click" />
                <Button Content="이미지" Tag="image" Click="VaultCategory_Click" />
                <Button Content="영상" Tag="video" Click="VaultCategory_Click" />
                <Button Content="문서" Tag="doc" Click="VaultCategory_Click" />
                <Button Content="기타" Tag="etc" Click="VaultCategory_Click" />
            </StackPanel>
            <Grid Grid.Row="3" Margin="0,12,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VaultSummaryText" VerticalAlignment="Center" FontSize="11" Foreground="#8A94A6" />
                <ComboBox x:Name="VaultSortComboBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="VaultSort_Changed">
                    <ComboBoxItem Content="최신순" Tag="newest" />
                    <ComboBoxItem Content="오래된순" Tag="oldest" />
                    <ComboBoxItem Content="이름순" Tag="name" />
                </ComboBox>
            </Grid>
            <ListView x:Name="VaultList" Grid.Row="4" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding OriginalName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#8A94A6" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding CreatedAt, Converter={StaticResource KoreanTimeConverter}}"
                                           FontSize="10" Foreground="#98A1B2" VerticalAlignment="Center" />
                                <Button Content="채팅에서 보기" Tag="{Binding}" Click="OpenVaultMessage_Click" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
