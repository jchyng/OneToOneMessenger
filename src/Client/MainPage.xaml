<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OneToOneMessenger_Client.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:converters="using:OneToOneMessenger_Client.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    Background="{StaticResource BrushSurface}"
    KeyDown="MainPage_KeyDown"
    SizeChanged="MainPage_SizeChanged">

    <Page.Resources>
        <converters:ChatMessageAlignmentConverter x:Key="ChatMessageAlignmentConverter" />
        <converters:ChatMessageBrushConverter x:Key="ChatMessageBrushConverter" />
        <converters:ChatBubbleCornerRadiusConverter x:Key="ChatBubbleCornerRadiusConverter" />
        <converters:BubbleTextForegroundConverter x:Key="BubbleTextForegroundConverter" />
        <converters:BubbleTailBrushConverter x:Key="BubbleTailBrushConverter" />
        <converters:BubbleBorderThicknessConverter x:Key="BubbleBorderThicknessConverter" />
        <converters:KoreanTimeConverter x:Key="KoreanTimeConverter" />
        <converters:ReadStateConverter x:Key="ReadStateConverter" />
        <converters:FilePreviewUriConverter x:Key="FilePreviewUriConverter" />
        <converters:ImageCategoryVisibilityConverter x:Key="ImageCategoryVisibilityConverter" />
        <converters:FileCategoryVisibilityConverter x:Key="FileCategoryVisibilityConverter" />
        <converters:TextVisibilityConverter x:Key="TextVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />
        <converters:FileSizeConverter x:Key="FileSizeConverter" />
        <converters:FileCategoryLabelConverter x:Key="FileCategoryLabelConverter" />
        <converters:FileCategoryGlyphConverter x:Key="FileCategoryGlyphConverter" />
        <converters:FileCategoryIconBrushConverter x:Key="FileCategoryIconBrushConverter" />
        <converters:FriendlyDateConverter x:Key="FriendlyDateConverter" />
        <converters:SearchPreviewConverter x:Key="SearchPreviewConverter" />
        <converters:AvatarImageSourceConverter x:Key="AvatarImageSourceConverter" />
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchKeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <SplitView x:Name="VaultSplitView"
               IsPaneOpen="True"
               DisplayMode="Inline"
               PanePlacement="Right"
               CompactPaneLength="0"
               OpenPaneLength="360"
               Background="{StaticResource BrushSurface}">

        <!-- ═══════════════════════════════
             보관함 패널 (우측)
        ═══════════════════════════════ -->
        <SplitView.Pane>
            <Grid Background="{StaticResource BrushSurfaceAlt}"
                  BorderBrush="{StaticResource BrushStroke}"
                  BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="68" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="16,0,10,0" BorderBrush="{StaticResource BrushStroke}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource BrushAccentSoft}" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{StaticResource BrushAccent}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="보관함" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="{StaticResource WeightSemiBold}" Foreground="{StaticResource BrushTextStrong}" />
                        <TextBlock x:Name="VaultSummaryText" Text="파일을 불러오는 중" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" Foreground="{StaticResource BrushTextMeta}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource HeaderIconButtonStyle}" Content="&#xE711;" Click="CloseVaultButton_Click" ToolTipService.ToolTip="보관함 닫기" AutomationProperties.Name="보관함 닫기" />
                </Grid>

                <Grid Grid.Row="1" Margin="14,12,14,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="VaultSearchInput" Style="{StaticResource SearchTextBoxStyle}" PlaceholderText="파일명 검색" TextChanged="VaultSearchInput_TextChanged" KeyDown="VaultSearchInput_KeyDown" AutomationProperties.Name="보관함 파일명 검색" />
                        <FontIcon Glyph="&#xE721;" FontSize="13" Foreground="{StaticResource BrushTextMeta}" Margin="13,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <ComboBox x:Name="VaultSortComboBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="VaultSort_Changed" HorizontalAlignment="Stretch" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeCaption}" AutomationProperties.Name="파일 정렬">
                        <ComboBoxItem Content="최신순" Tag="newest" />
                        <ComboBoxItem Content="오래된순" Tag="oldest" />
                        <ComboBoxItem Content="이름순" Tag="name" />
                    </ComboBox>
                </Grid>

                <ScrollViewer Grid.Row="2" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="14,0,14,10">
                        <ToggleButton x:Name="AllVaultCategoryButton" Style="{StaticResource FilterChipStyle}" Content="전체" Tag="" Click="VaultCategory_Click" IsChecked="True" />
                        <ToggleButton x:Name="ImageVaultCategoryButton" Style="{StaticResource FilterChipStyle}" Content="이미지" Tag="image" Click="VaultCategory_Click" />
                        <ToggleButton x:Name="VideoVaultCategoryButton" Style="{StaticResource FilterChipStyle}" Content="영상" Tag="video" Click="VaultCategory_Click" />
                        <ToggleButton x:Name="DocumentVaultCategoryButton" Style="{StaticResource FilterChipStyle}" Content="문서" Tag="doc" Click="VaultCategory_Click" />
                        <ToggleButton x:Name="OtherVaultCategoryButton" Style="{StaticResource FilterChipStyle}" Content="기타" Tag="etc" Click="VaultCategory_Click" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Margin="14,0,14,10" Spacing="8">
                    <TextBlock Text="파일 유형" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeCaption}" FontWeight="{StaticResource WeightSemiBold}" Foreground="{StaticResource BrushTextStrong}" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56" />
                            <RowDefinition Height="56" />
                        </Grid.RowDefinitions>
                        <Button Tag="image" Click="VaultSummaryCategory_Click" Padding="10,7" HorizontalContentAlignment="Stretch" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushStroke}" BorderThickness="1" CornerRadius="12">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="8" Background="#E3F1FF"><FontIcon Glyph="&#xEB9F;" FontSize="13" Foreground="#288AD6" /></Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="이미지" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" Foreground="{StaticResource BrushTextMeta}" />
                                    <TextBlock x:Name="ImageSummaryCountText" Text="0개" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeCaption}" FontWeight="{StaticResource WeightSemiBold}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Grid.Column="1" Tag="doc" Click="VaultSummaryCategory_Click" Padding="10,7" HorizontalContentAlignment="Stretch" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushStroke}" BorderThickness="1" CornerRadius="12">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="8" Background="#EEEEFF"><FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="#5B56D8" /></Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="문서" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" Foreground="{StaticResource BrushTextMeta}" />
                                    <TextBlock x:Name="DocumentSummaryCountText" Text="0개" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeCaption}" FontWeight="{StaticResource WeightSemiBold}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Grid.Row="1" Tag="video" Click="VaultSummaryCategory_Click" Padding="10,7" HorizontalContentAlignment="Stretch" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushStroke}" BorderThickness="1" CornerRadius="12">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="8" Background="#FCEEF4"><FontIcon Glyph="&#xE714;" FontSize="13" Foreground="#C94D7C" /></Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="영상" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" Foreground="{StaticResource BrushTextMeta}" />
                                    <TextBlock x:Name="VideoSummaryCountText" Text="0개" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeCaption}" FontWeight="{StaticResource WeightSemiBold}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1" Tag="etc" Click="VaultSummaryCategory_Click" Padding="10,7" HorizontalContentAlignment="Stretch" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushStroke}" BorderThickness="1" CornerRadius="12">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="8" Background="#F0F2F5"><FontIcon Glyph="&#xE7C3;" FontSize="13" Foreground="#697386" /></Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="기타" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" Foreground="{StaticResource BrushTextMeta}" />
                                    <TextBlock x:Name="OtherSummaryCountText" Text="0개" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeCaption}" FontWeight="{StaticResource WeightSemiBold}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="4" Margin="14,0,6,5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="RecentFilesTitle" Text="최근 파일" VerticalAlignment="Center" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeCaption}" FontWeight="{StaticResource WeightSemiBold}" Foreground="{StaticResource BrushTextStrong}" />
                    <Button Grid.Column="1" Style="{StaticResource CompactIconButtonStyle}" Content="&#xE72C;" Click="RefreshVaultButton_Click" ToolTipService.ToolTip="새로 고침" AutomationProperties.Name="보관함 새로 고침" />
                </Grid>

                <Grid Grid.Row="5" Margin="6,0,6,6">
                    <ListView x:Name="VaultList" SelectionMode="None" ItemContainerStyle="{StaticResource VaultListViewItemStyle}" Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" ToolTipService.ToolTip="{Binding OriginalName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="10"
                                            Background="{Binding Category, Converter={StaticResource FileCategoryIconBrushConverter}}" BorderThickness="0">
                                        <FontIcon Glyph="{Binding Category, Converter={StaticResource FileCategoryGlyphConverter}}"
                                                  FontSize="15"
                                                  Foreground="{Binding Category, Converter={StaticResource FileCategoryIconBrushConverter}, ConverterParameter=fg}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding OriginalName}" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeCaption}" FontWeight="{StaticResource WeightSemiBold}" Foreground="{StaticResource BrushTextPrimary}" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding Category, Converter={StaticResource FileCategoryLabelConverter}}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" Foreground="{StaticResource BrushTextMeta}" />
                                            <TextBlock Text="·" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" Foreground="{StaticResource BrushTextMeta}" />
                                            <TextBlock Text="{Binding SizeBytes, Converter={StaticResource FileSizeConverter}}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" Foreground="{StaticResource BrushTextMeta}" />
                                            <TextBlock Text="·" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" Foreground="{StaticResource BrushTextMeta}" />
                                            <TextBlock Text="{Binding CreatedAt, Converter={StaticResource FriendlyDateConverter}}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" Foreground="{StaticResource BrushTextMeta}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource CompactIconButtonStyle}" Content="&#xE896;" Tag="{Binding}" Click="DownloadFile_Click" ToolTipService.ToolTip="다운로드" AutomationProperties.Name="파일 다운로드" />
                                        <Button Style="{StaticResource CompactIconButtonStyle}" Content="&#xE74E;" Tag="{Binding}" Click="SaveAsFile_Click" ToolTipService.ToolTip="다른 이름으로 저장" AutomationProperties.Name="다른 이름으로 저장" />
                                        <Button Style="{StaticResource CompactIconButtonStyle}" Content="&#xE8F1;" Tag="{Binding}" Click="OpenVaultMessage_Click" ToolTipService.ToolTip="채팅에서 보기" AutomationProperties.Name="채팅에서 보기" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="VaultEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed" IsHitTestVisible="False">
                        <Border Width="50" Height="50" CornerRadius="25" Background="{StaticResource BrushAccentSoft}">
                            <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{StaticResource BrushAccent}" />
                        </Border>
                        <TextBlock Text="파일이 없습니다" HorizontalAlignment="Center" FontFamily="{StaticResource AppFontFamily}" FontWeight="{StaticResource WeightSemiBold}" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="주고받은 파일이 여기에 모입니다" HorizontalAlignment="Center" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource BrushTextMeta}" />
                    </StackPanel>
                    <ProgressRing x:Name="VaultLoadingRing" Width="26" Height="26" IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </SplitView.Pane>

        <!-- ═══════════════════════════════
             채팅 메인 영역 (좌측)
        ═══════════════════════════════ -->
        <SplitView.Content>
            <Grid x:Name="ChatSurface"
                  Background="{StaticResource BrushSurface}"
                  AllowDrop="True"
                  DragEnter="ChatArea_DragEnter"
                  DragLeave="ChatArea_DragLeave"
                  DragOver="ChatArea_DragOver"
                  Drop="ChatArea_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="68" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 헤더 -->
                <Grid Padding="16,0,12,0" Background="{StaticResource BrushSurface}"
                      BorderBrush="{StaticResource BrushStroke}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="42" Height="42" VerticalAlignment="Center">
                        <Ellipse x:Name="PartnerAvatarEllipse" Fill="{StaticResource BrushAccentSoft}" />
                        <Ellipse x:Name="PartnerAvatarImage" Visibility="Collapsed">
                            <Ellipse.Fill><ImageBrush Stretch="UniformToFill" /></Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="PartnerAvatarInitial" Text="짱" FontFamily="{StaticResource AppFontFamily}" FontSize="15" FontWeight="{StaticResource WeightSemiBold}" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Width="13" Height="13" CornerRadius="7" Padding="2.5" Background="{StaticResource BrushSurface}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Ellipse x:Name="PresenceDot" Fill="{StaticResource BrushOffline}" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="PartnerNameText" Text="짱구" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="{StaticResource WeightSemiBold}" Foreground="{StaticResource BrushTextStrong}" />
                        <TextBlock x:Name="PresenceText" Text="연결 중…" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource BrushTextMeta}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Style="{StaticResource HeaderIconButtonStyle}" Content="&#xE721;" Click="SearchButton_Click" ToolTipService.ToolTip="대화 검색 (Ctrl+F)" AutomationProperties.Name="대화 검색" />
                        <Button x:Name="VaultToggleButton" Style="{StaticResource HeaderIconButtonStyle}" Content="&#xE8B7;" Click="VaultToggleButton_Click" ToolTipService.ToolTip="보관함 열기 또는 닫기" AutomationProperties.Name="보관함" />
                        <Button Style="{StaticResource HeaderIconButtonStyle}" Content="&#xE712;" Click="SettingsButton_Click" ToolTipService.ToolTip="설정" AutomationProperties.Name="설정" />
                    </StackPanel>
                </Grid>

                <!-- 연결 배너 -->
                <Border x:Name="ConnectionBanner" Grid.Row="1" Background="#FFF4D8" Padding="16,7" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="#9A6700" />
                        <TextBlock x:Name="ConnectionBannerText" Text="연결이 끊겼습니다. 다시 연결하는 중…" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeCaption}" Foreground="#7A5200" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 채팅 타임라인 -->
                <Grid Grid.Row="2" Background="{StaticResource BrushChatCanvas}">
                    <Canvas x:Name="PatternCanvas" IsHitTestVisible="False" SizeChanged="PatternCanvas_SizeChanged" />

                    <ListView x:Name="MessagesList"
                              Padding="20,14,20,20"
                              SelectionMode="None"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource MessageListViewItemStyle}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- 날짜 구분선 -->
                                    <Grid Margin="4,16,4,14" Visibility="{Binding ShowDateHeader, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Height="1" Background="{StaticResource BrushStroke}" VerticalAlignment="Center" Opacity="0.6" />
                                        <Border Grid.Column="1" Margin="10,0" Padding="12,5" CornerRadius="12" Background="{StaticResource BrushSurface}">
                                            <TextBlock Text="{Binding DateHeader}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" Foreground="{StaticResource BrushTextMeta}" />
                                        </Border>
                                        <Border Grid.Column="2" Height="1" Background="{StaticResource BrushStroke}" VerticalAlignment="Center" Opacity="0.6" />
                                    </Grid>

                                    <!-- 메시지 행 -->
                                    <Grid MaxWidth="580"
                                          Margin="{Binding GroupMargin}"
                                          HorizontalAlignment="{Binding IsMine, Converter={StaticResource ChatMessageAlignmentConverter}}"
                                          ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 상대방 아바타 -->
                                        <Grid Width="34" Height="34" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                              Visibility="{Binding ShowAvatar, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Ellipse Fill="{StaticResource BrushAccentSoft}" />
                                            <Ellipse x:Name="MessageAvatarImage" Visibility="Collapsed">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource AvatarImageSourceConverter}}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="{Binding PartnerInitial}"
                                                       FontFamily="{StaticResource AppFontFamily}" FontSize="11" FontWeight="{StaticResource WeightSemiBold}"
                                                       Foreground="{StaticResource BrushAccent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding AvatarPath, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}, ConverterParameter=Invert}" />
                                        </Grid>

                                        <!-- 메시지 컨텐츠 -->
                                        <StackPanel Grid.Column="1" MaxWidth="520" Spacing="3">
                                            <!-- 발신자 이름 -->
                                            <TextBlock Text="{Binding Message.Sender}"
                                                       Visibility="{Binding ShowSender, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       FontFamily="{StaticResource AppFontFamily}"
                                                       FontSize="{StaticResource FontSizeMeta}"
                                                       FontWeight="{StaticResource WeightSemiBold}"
                                                       Foreground="{StaticResource BrushAccent}"
                                                       Margin="2,0,0,1" />

                                            <!-- ─── 케이스 1: 파일 전용 (말풍선 없이 카드만) ─── -->
                                            <StackPanel Visibility="{Binding IsFileOnly, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Spacing="3">
                                                <Border Width="300" Padding="12,10"
                                                        Background="{StaticResource BrushSurface}"
                                                        BorderBrush="{StaticResource BrushStroke}"
                                                        BorderThickness="1"
                                                        CornerRadius="14">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="44" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="44" Height="44" CornerRadius="12"
                                                                Background="{Binding Message.File.Category, Converter={StaticResource FileCategoryIconBrushConverter}}">
                                                            <FontIcon Glyph="{Binding Message.File.Category, Converter={StaticResource FileCategoryGlyphConverter}}"
                                                                      FontSize="20"
                                                                      Foreground="{Binding Message.File.Category, Converter={StaticResource FileCategoryIconBrushConverter}, ConverterParameter=fg}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                            <TextBlock Text="{Binding Message.File.OriginalName}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       FontFamily="{StaticResource AppFontFamily}"
                                                                       FontSize="{StaticResource FontSizeBody}"
                                                                       FontWeight="{StaticResource WeightSemiBold}"
                                                                       Foreground="{StaticResource BrushTextStrong}"
                                                                       ToolTipService.ToolTip="{Binding Message.File.OriginalName}" />
                                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                                <TextBlock Text="{Binding Message.File.Category, Converter={StaticResource FileCategoryLabelConverter}}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource BrushTextMeta}" />
                                                                <TextBlock Text="·" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource BrushTextMeta}" />
                                                                <TextBlock Text="{Binding Message.File.SizeBytes, Converter={StaticResource FileSizeConverter}}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource BrushTextMeta}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                                                            <Button Style="{StaticResource FileActionButtonStyle}" Content="&#xE896;" Tag="{Binding Message.File}"
                                                                    Click="DownloadFile_Click" ToolTipService.ToolTip="다운로드" AutomationProperties.Name="파일 다운로드" />
                                                            <Button Style="{StaticResource FileActionButtonStyle}" Content="&#xE74E;" Tag="{Binding Message.File}"
                                                                    Click="SaveAsFile_Click" ToolTipService.ToolTip="다른 이름으로 저장" AutomationProperties.Name="다른 이름으로 저장" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Spacing="4"
                                                            HorizontalAlignment="{Binding IsMine, Converter={StaticResource ChatMessageAlignmentConverter}}">
                                                    <TextBlock Text="{Binding Message.SentAt, Converter={StaticResource KoreanTimeConverter}}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" Foreground="{StaticResource BrushTextMeta}" />
                                                    <TextBlock Text="{Binding Message.IsRead, Converter={StaticResource ReadStateConverter}}" Visibility="{Binding IsMine, Converter={StaticResource BooleanToVisibilityConverter}}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" Foreground="{StaticResource BrushAccent}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- ─── 케이스 2: 일반 말풍선 (텍스트 / 이미지 / 텍스트+파일) ─── -->
                                            <StackPanel Visibility="{Binding ShowBubble, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Spacing="3">
                                                <Grid>
                                                    <Border Background="{Binding IsMine, Converter={StaticResource ChatMessageBrushConverter}}"
                                                            CornerRadius="{Binding IsMine, Converter={StaticResource ChatBubbleCornerRadiusConverter}}"
                                                            Padding="12,9"
                                                            BorderBrush="{StaticResource BrushBubbleInBorder}"
                                                            BorderThickness="{Binding IsMine, Converter={StaticResource BubbleBorderThicknessConverter}}">
                                                        <StackPanel Spacing="7">
                                                            <!-- 텍스트 -->
                                                            <TextBlock Text="{Binding Message.Body}"
                                                                       Visibility="{Binding Message.Body, Converter={StaticResource TextVisibilityConverter}}"
                                                                       TextWrapping="WrapWholeWords"
                                                                       FontFamily="{StaticResource AppFontFamily}"
                                                                       FontSize="{StaticResource FontSizeBody}"
                                                                       Foreground="{Binding IsMine, Converter={StaticResource BubbleTextForegroundConverter}}"
                                                                       MaxWidth="440" />
                                                            <!-- 이미지 -->
                                                            <Border Visibility="{Binding Message.File, Converter={StaticResource ImageCategoryVisibilityConverter}}"
                                                                    CornerRadius="10" Background="{StaticResource BrushStroke}" MaxWidth="320">
                                                                <Grid>
                                                                    <Image Source="{Binding Message.File.Id, Converter={StaticResource FilePreviewUriConverter}}"
                                                                           MaxWidth="320" MaxHeight="220" Stretch="Uniform"
                                                                           ImageFailed="PreviewImage_Failed"
                                                                           Tapped="PreviewImage_Tapped"
                                                                           Tag="{Binding Message.File.Id}"
                                                                           ToolTipService.ToolTip="크게 보기" />
                                                                    <StackPanel Visibility="Collapsed" Padding="28" Spacing="6" HorizontalAlignment="Center">
                                                                        <FontIcon Glyph="&#xEB9F;" FontSize="24" Foreground="{StaticResource BrushTextMeta}" />
                                                                        <TextBlock Text="미리보기를 불러오지 못했습니다" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" Foreground="{StaticResource BrushTextMeta}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <!-- 파일 카드 (텍스트와 함께 올 때만, IsFileOnly=false이면서 파일 있을 때) -->
                                                            <Border Width="300" Padding="10,9"
                                                                    Background="#D9FFFFFF" BorderThickness="0" CornerRadius="12"
                                                                    Visibility="{Binding Message.File, Converter={StaticResource FileCategoryVisibilityConverter}}">
                                                                <Grid ColumnSpacing="10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="40" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Width="40" Height="40" CornerRadius="10"
                                                                            Background="{Binding Message.File.Category, Converter={StaticResource FileCategoryIconBrushConverter}}">
                                                                        <FontIcon Glyph="{Binding Message.File.Category, Converter={StaticResource FileCategoryGlyphConverter}}"
                                                                                  FontSize="18"
                                                                                  Foreground="{Binding Message.File.Category, Converter={StaticResource FileCategoryIconBrushConverter}, ConverterParameter=fg}" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                        <TextBlock Text="{Binding Message.File.OriginalName}" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeCaption}" FontWeight="{StaticResource WeightSemiBold}" Foreground="{StaticResource BrushTextStrong}" ToolTipService.ToolTip="{Binding Message.File.OriginalName}" />
                                                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                                                            <TextBlock Text="{Binding Message.File.Category, Converter={StaticResource FileCategoryLabelConverter}}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" Foreground="{StaticResource BrushTextMeta}" />
                                                                            <TextBlock Text="·" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" Foreground="{StaticResource BrushTextMeta}" />
                                                                            <TextBlock Text="{Binding Message.File.SizeBytes, Converter={StaticResource FileSizeConverter}}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" Foreground="{StaticResource BrushTextMeta}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                                                                        <Button Style="{StaticResource FileActionButtonStyle}" Content="&#xE896;" Tag="{Binding Message.File}" Click="DownloadFile_Click" ToolTipService.ToolTip="다운로드" AutomationProperties.Name="파일 다운로드" />
                                                                        <Button Style="{StaticResource FileActionButtonStyle}" Content="&#xE74E;" Tag="{Binding Message.File}" Click="SaveAsFile_Click" ToolTipService.ToolTip="다른 이름으로 저장" AutomationProperties.Name="다른 이름으로 저장" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- 수신 꼬리 -->
                                                    <Path Data="M 0,0 L 9,0 L 0,11 Z" Fill="White"
                                                          HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                          Margin="-1,0,0,0" IsHitTestVisible="False">
                                                        <Path.RenderTransform><TranslateTransform X="-8" Y="0" /></Path.RenderTransform>
                                                        <Path.Visibility><Binding Path="ShowTailIncoming" Converter="{StaticResource BooleanToVisibilityConverter}" /></Path.Visibility>
                                                    </Path>
                                                    <!-- 발신 꼬리 -->
                                                    <Path Data="M 0,0 L 9,0 L 9,11 Z" Fill="#3D7EFF"
                                                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                          IsHitTestVisible="False">
                                                        <Path.RenderTransform><TranslateTransform X="8" Y="0" /></Path.RenderTransform>
                                                        <Path.Visibility><Binding Path="ShowTailOutgoing" Converter="{StaticResource BooleanToVisibilityConverter}" /></Path.Visibility>
                                                    </Path>
                                                </Grid>
                                                <!-- 시간 + 읽음 -->
                                                <StackPanel Orientation="Horizontal" Spacing="4"
                                                            HorizontalAlignment="{Binding IsMine, Converter={StaticResource ChatMessageAlignmentConverter}}">
                                                    <TextBlock Text="{Binding Message.SentAt, Converter={StaticResource KoreanTimeConverter}}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" Foreground="{StaticResource BrushTextMeta}" />
                                                    <TextBlock Text="{Binding Message.IsRead, Converter={StaticResource ReadStateConverter}}" Visibility="{Binding IsMine, Converter={StaticResource BooleanToVisibilityConverter}}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" Foreground="{StaticResource BrushAccent}" />
                                                </StackPanel>
                                            </StackPanel>

                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="MessagesEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed" IsHitTestVisible="False">
                        <Border Width="68" Height="68" CornerRadius="34" Background="{StaticResource BrushAccentSoft}">
                            <FontIcon Glyph="&#xE8BD;" FontSize="28" Foreground="{StaticResource BrushAccent}" />
                        </Border>
                        <TextBlock Text="대화를 시작해 보세요" HorizontalAlignment="Center" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="{StaticResource WeightSemiBold}" Foreground="{StaticResource BrushTextStrong}" />
                        <TextBlock x:Name="EmptyStatePartnerText" Text="짱구에게 첫 메시지나 파일을 보내세요" HorizontalAlignment="Center" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource BrushTextMeta}" />
                    </StackPanel>

                    <StackPanel x:Name="MessagesLoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <ProgressRing Width="30" Height="30" IsActive="True" />
                        <TextBlock Text="대화를 불러오는 중…" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource BrushTextMeta}" />
                    </StackPanel>

                    <InfoBar x:Name="OperationInfoBar" IsOpen="False" IsClosable="True"
                             HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16"
                             MaxWidth="560" Severity="Informational" />

                    <!-- 대화 검색 오버레이 -->
                    <Grid x:Name="SearchOverlay" Background="{StaticResource BrushSurface}" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="18,14,18,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="대화 검색" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeTitle}" FontWeight="{StaticResource WeightSemiBold}" Foreground="{StaticResource BrushTextStrong}" />
                                <TextBlock Text="메시지 내용에서 검색합니다" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource BrushTextMeta}" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource HeaderIconButtonStyle}" Content="&#xE711;" Click="CloseSearchButton_Click" ToolTipService.ToolTip="검색 닫기 (Esc)" AutomationProperties.Name="검색 닫기" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="18,4,18,12">
                            <TextBox x:Name="MessageSearchInput" Style="{StaticResource SearchTextBoxStyle}" PlaceholderText="검색어를 입력하고 Enter를 누르세요" KeyDown="MessageSearchInput_KeyDown" AutomationProperties.Name="대화 검색어" />
                            <FontIcon Glyph="&#xE721;" FontSize="13" Foreground="{StaticResource BrushTextMeta}" Margin="13,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <Button Style="{StaticResource CompactIconButtonStyle}" Content="&#xE721;" Click="MessageSearchButton_Click" HorizontalAlignment="Right" Margin="0,0,6,0" ToolTipService.ToolTip="검색" AutomationProperties.Name="검색 실행" />
                        </Grid>
                        <Grid Grid.Row="2" Padding="18,0,18,16">
                            <ListView x:Name="SearchResultsList" IsItemClickEnabled="True" ItemClick="SearchResultsList_ItemClick"
                                      SelectionMode="None" ItemContainerStyle="{StaticResource ResultListViewItemStyle}"
                                      Background="Transparent" BorderThickness="0">
                                <ListView.Header>
                                    <TextBlock x:Name="SearchStatusText" Margin="4,0,4,8" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource BrushTextMeta}" />
                                </ListView.Header>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="10,9" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource BrushAccentSoft}">
                                                <FontIcon Glyph="&#xE77B;" FontSize="13" Foreground="{StaticResource BrushAccent}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{Binding Msg.Sender}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" FontWeight="{StaticResource WeightSemiBold}" Foreground="{StaticResource BrushAccent}" />
                                                <TextBlock Text="{Binding HighlightedPreview, Converter={StaticResource SearchPreviewConverter}}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource BrushTextPrimary}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Msg.SentAt, Converter={StaticResource KoreanTimeConverter}}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" Foreground="{StaticResource BrushTextMeta}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 입력창 (Composer) -->
                <Border Grid.Row="3" Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushStroke}" BorderThickness="0,1,0,0"
                        Padding="10,8,10,10">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="TransferStatusPanel" Visibility="Collapsed" Margin="50,0,50,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock x:Name="TransferStatusText" Text="파일을 전송하는 중…" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeMeta}" Foreground="{StaticResource BrushTextMeta}" />
                                <ProgressBar x:Name="UploadProgress" Height="3" Minimum="0" Maximum="100" Foreground="{StaticResource BrushAccent}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="CancelTransferButton" Content="취소" Visibility="Collapsed" Click="CancelTransferButton_Click" />
                                <Button x:Name="RetryButton" Content="다시 시도" Visibility="Collapsed" Click="RetryButton_Click" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource ComposerButtonStyle}" Content="&#xE723;" Click="ChooseFile_Click"
                                    ToolTipService.ToolTip="파일 첨부" AutomationProperties.Name="파일 첨부"
                                    VerticalAlignment="Bottom" Margin="0,0,0,2" />
                            <TextBox x:Name="MessageInput" Grid.Column="1"
                                     Style="{StaticResource RoundedTextBoxStyle}"
                                     MinHeight="44" MaxHeight="130" Padding="16,11"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     PlaceholderText="메시지를 입력하세요"
                                     KeyDown="MessageInput_KeyDown"
                                     TextChanged="MessageInput_TextChanged"
                                     TextCompositionStarted="MessageInput_TextCompositionStarted"
                                     TextCompositionEnded="MessageInput_TextCompositionEnded"
                                     AutomationProperties.Name="메시지 입력"
                                     ToolTipService.ToolTip="Enter 전송 · Shift+Enter 줄바꿈" />
                            <Button x:Name="SendButton" Grid.Column="2"
                                    Style="{StaticResource SendButtonStyle}"
                                    Content="&#xE724;" Click="SendButton_Click" IsEnabled="False"
                                    ToolTipService.ToolTip="메시지 전송" AutomationProperties.Name="메시지 전송"
                                    VerticalAlignment="Bottom" Margin="0,0,0,2" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- 드래그 드롭 오버레이 -->
                <Border x:Name="DropOverlay" Grid.Row="2" Grid.RowSpan="2" Margin="14"
                        Background="#EAF2FF" BorderBrush="{StaticResource BrushAccent}" BorderThickness="2"
                        CornerRadius="18" Visibility="Collapsed" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource BrushAccentSoft}">
                            <FontIcon Glyph="&#xE898;" FontSize="26" Foreground="{StaticResource BrushAccent}" />
                        </Border>
                        <TextBlock Text="파일을 놓아서 전송" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="{StaticResource WeightSemiBold}" Foreground="{StaticResource BrushTextStrong}" />
                        <TextBlock Text="여러 파일을 한 번에 보낼 수 있습니다" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource BrushTextMeta}" />
                    </StackPanel>
                </Border>
            </Grid>
        </SplitView.Content>
    </SplitView>
</Page>
