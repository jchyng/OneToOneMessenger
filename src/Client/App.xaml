<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="OneToOneMessenger_Client.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneToOneMessenger_Client"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Color system -->
            <Color x:Key="ColorAccent">#3D7EFF</Color>
            <Color x:Key="ColorAccentHover">#326FE8</Color>
            <Color x:Key="ColorAccentSoft">#EAF2FF</Color>
            <Color x:Key="ColorSurface">#FFFFFF</Color>
            <Color x:Key="ColorSurfaceAlt">#F5F7FA</Color>
            <Color x:Key="ColorChatCanvas">#FAFBFD</Color>
            <Color x:Key="ColorBubbleIn">#F0F2F5</Color>
            <Color x:Key="ColorStroke">#E5E9F0</Color>
            <Color x:Key="ColorStrokeStrong">#D7DDE7</Color>
            <Color x:Key="ColorTextPrimary">#273142</Color>
            <Color x:Key="ColorTextStrong">#161C27</Color>
            <Color x:Key="ColorTextMeta">#7D889B</Color>
            <Color x:Key="ColorSuccess">#20B968</Color>
            <Color x:Key="ColorDanger">#E5484D</Color>
            <Color x:Key="ColorWarning">#F2A93B</Color>
            <Color x:Key="ColorOverlay">#660E1726</Color>

            <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
            <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}" />
            <SolidColorBrush x:Key="BrushAccentSoft" Color="{StaticResource ColorAccentSoft}" />
            <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
            <SolidColorBrush x:Key="BrushSurfaceAlt" Color="{StaticResource ColorSurfaceAlt}" />
            <SolidColorBrush x:Key="BrushChatCanvas" Color="{StaticResource ColorChatCanvas}" />
            <SolidColorBrush x:Key="BrushBubbleIn" Color="{StaticResource ColorBubbleIn}" />
            <SolidColorBrush x:Key="BrushBubbleOut" Color="{StaticResource ColorAccentSoft}" />
            <SolidColorBrush x:Key="BrushStroke" Color="{StaticResource ColorStroke}" />
            <SolidColorBrush x:Key="BrushStrokeStrong" Color="{StaticResource ColorStrokeStrong}" />
            <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
            <SolidColorBrush x:Key="BrushTextStrong" Color="{StaticResource ColorTextStrong}" />
            <SolidColorBrush x:Key="BrushTextMeta" Color="{StaticResource ColorTextMeta}" />
            <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
            <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
            <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
            <SolidColorBrush x:Key="BrushOverlay" Color="{StaticResource ColorOverlay}" />

            <!-- Shape and spacing tokens -->
            <CornerRadius x:Key="RadiusBubble">16</CornerRadius>
            <CornerRadius x:Key="RadiusCard">12</CornerRadius>
            <CornerRadius x:Key="RadiusInput">22</CornerRadius>
            <CornerRadius x:Key="RadiusButton">10</CornerRadius>
            <CornerRadius x:Key="RadiusRound">999</CornerRadius>
            <x:Double x:Key="SpacePage">20</x:Double>
            <x:Double x:Key="SpaceSection">16</x:Double>
            <x:Double x:Key="SpaceInline">8</x:Double>

            <!-- Type scale -->
            <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
            <x:Double x:Key="FontSizeTitle">18</x:Double>
            <x:Double x:Key="FontSizeSubtitle">16</x:Double>
            <x:Double x:Key="FontSizeBody">14</x:Double>
            <x:Double x:Key="FontSizeCaption">12</x:Double>
            <x:Double x:Key="FontSizeMeta">11</x:Double>
            <FontWeight x:Key="WeightMedium">Medium</FontWeight>
            <FontWeight x:Key="WeightSemiBold">SemiBold</FontWeight>

            <!-- Buttons -->
            <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="ComposerButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderIconButtonStyle}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Background" Value="{StaticResource BrushBubbleIn}" />
            </Style>

            <Style x:Key="SendButtonStyle" TargetType="Button" BasedOn="{StaticResource ComposerButtonStyle}">
                <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="CompactIconButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderIconButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="FilterChipStyle" TargetType="ToggleButton">
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="52" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Background" Value="{StaticResource BrushBubbleIn}" />
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
                <Setter Property="FontWeight" Value="{StaticResource WeightSemiBold}" />
            </Style>

            <!-- Inputs -->
            <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="Padding" Value="14,9" />
                <Setter Property="Background" Value="{StaticResource BrushBubbleIn}" />
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                <Setter Property="PlaceholderForeground" Value="{StaticResource BrushTextMeta}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusInput}" />
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            </Style>

            <Style x:Key="SearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBoxStyle}">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="38,9,14,9" />
            </Style>

            <!-- Lists -->
            <Style x:Key="MessageListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="IsTabStop" Value="False" />
            </Style>

            <Style x:Key="ResultListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <Style x:Key="VaultListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
